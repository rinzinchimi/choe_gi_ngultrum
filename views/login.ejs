<%- include('partials/header') %>

<div style="max-width: 480px; margin: 2rem auto;">
  <div class="card" style="padding: 2rem;">
    <div style="text-align: center; margin-bottom: 1.75rem;">
      <div class="brand-emblem" style="margin: 0 auto 0.75rem;">Nu.</div>
      <h2 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Sign In</h2>
      <p style="color: var(--text-muted); font-size: 0.875rem;">Access the Choe Gi Ngultrum transparency portal</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <form action="/login" method="POST">
      <% if (typeof csrfToken !== 'undefined') { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% } %>

      <div class="form-group">
        <label for="email" class="form-label">College Email Address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="name@college.edu.bt" value="<%= typeof email !== 'undefined' ? email : '' %>" required autofocus>
      </div>

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
          <label for="password" class="form-label">Password</label>
          <a href="/forgot-password" style="font-size: 0.8rem; color: var(--primary);">Forgot Password?</a>
        </div>
        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; margin-top: 0.5rem;">
        Sign In to Portal
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
      Don't have an account? <a href="/signup" style="font-weight: 600;">Register as Student</a>
    </div>

    <!-- Quick Demo Logins Helper -->
    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px dashed var(--border);">
      <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.75rem; text-align: center;">
        ⚡ Demo Accounts (Shared Password: <code style="color: var(--accent);">Transparency@2026</code>)
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; font-size: 0.775rem;">
        <button type="button" class="btn btn-sm btn-secondary" onclick="fillDemo('student@sherubtse.rub.edu.bt')">🎓 Student</button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="fillDemo('leader@sherubtse.rub.edu.bt')">⭐ Leader</button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="fillDemo('finance@sherubtse.rub.edu.bt')">💼 Finance</button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="fillDemo('admin@sherubtse.rub.edu.bt')">🛡️ Admin</button>
        <button type="button" class="btn btn-sm btn-secondary" style="grid-column: span 2;" onclick="fillDemo('auditor@sherubtse.rub.edu.bt')">🔍 Auditor</button>
      </div>
    </div>
  </div>
</div>

<script>
  function fillDemo(email) {
    document.getElementById('email').value = email;
    document.getElementById('password').value = 'Transparency@2026';
  }
</script>

<%- include('partials/footer') %>
