<aside class="admin-sidebar">
  <div style="padding-bottom: 0.75rem; margin-bottom: 0.75rem; border-bottom: 1px solid var(--border);">
    <div style="font-size: 0.75rem; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.5px;"><%= user.role === 'student_leader' ? 'Expense Entry' : 'Administration' %></div>
    <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-main);"><%= user.name %></div>
    <div style="font-size: 0.775rem; color: var(--text-muted); text-transform: capitalize;"><%= user.role.replace('_', ' ') %></div>
  </div>

  <ul class="admin-menu">
    <li>
      <a href="/admin/expenditures" class="admin-menu-link <%= page === 'admin-expenditures' ? 'active' : '' %>">
        <span><%= user.role === 'student_leader' ? 'Record Expenses' : 'Expenditures' %></span>
      </a>
    </li>
    <% if (user.role !== 'student_leader') { %>
      <li>
        <a href="/admin/dashboard" class="admin-menu-link <%= page === 'admin-dashboard' ? 'active' : '' %>">
          <span>Overview</span>
        </a>
      </li>
      <li>
        <a href="/admin/budgets" class="admin-menu-link <%= page === 'admin-budgets' ? 'active' : '' %>">
          <span>Budgets</span>
        </a>
      </li>
      <% if (user.role === 'admin') { %>
        <li>
          <a href="/admin/approvals" class="admin-menu-link <%= page === 'admin-approvals' ? 'active' : '' %>">
            <span>Approval Queue</span>
          </a>
        </li>
        <li>
          <a href="/admin/role-approvals" class="admin-menu-link <%= page === 'admin-role-approvals' ? 'active' : '' %>">
            <span>Role Approvals</span>
          </a>
        </li>
      <% } %>
      <li>
        <a href="/admin/questions" class="admin-menu-link <%= page === 'admin-questions' ? 'active' : '' %>">
          <span>Questions Inbox</span>
        </a>
      </li>
      <% if (user.role === 'admin') { %>
        <li>
          <a href="/admin/users" class="admin-menu-link <%= page === 'admin-users' ? 'active' : '' %>">
            <span>Users &amp; Roles</span>
          </a>
        </li>
      <% } %>
      <li>
        <a href="/admin/reports" class="admin-menu-link <%= page === 'admin-reports' ? 'active' : '' %>">
          <span>Reports &amp; CSV</span>
        </a>
      </li>
      <li>
        <a href="/admin/audit-log" class="admin-menu-link <%= page === 'audit-log' ? 'active' : '' %>">
          <span>Audit Trail Log</span>
        </a>
      </li>
    <% } %>
  </ul>

  <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--border);">
    <a href="/dashboard" class="btn btn-sm btn-secondary" style="width: 100%;">
      &larr; Student View
    </a>
  </div>
</aside>
