<%- include('partials/header') %>

<div style="max-width: 480px; margin: 2rem auto;">
  <div class="card" style="padding: 2rem;">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.4rem; margin-bottom: 0.25rem;">Reset Password</h2>
      <p style="color: var(--text-muted); font-size: 0.875rem;">Enter your college email address to receive a reset token</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>

    <form action="/forgot-password" method="POST">
      <% if (typeof csrfToken !== 'undefined') { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% } %>

      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="name@college.edu.bt" required autofocus>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">
        Send Reset Link
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem;">
      <a href="/login">&larr; Back to Sign In</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

