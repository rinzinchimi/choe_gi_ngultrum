<%- include('partials/header') %>

<div style="max-width: 520px; margin: 3rem auto; text-align: center;">
  <div class="card" style="padding: 2.5rem 2rem;">
    <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">
      <%= delivery ? 'Account Created' : 'Check Your Email' %>
    </h2>

    <% if (delivery) { %>
      <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
        Gmail did not accept the development email. The verification link for <strong><%= email %></strong> was printed in the app server terminal. Open it on this computer or on a phone connected to the same Wi-Fi.
      </p>
    <% } else { %>
      <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
        A verification link has been sent to <strong><%= email %></strong>. Click it to confirm your college email and activate your account.
      </p>
    <% } %>

    <a href="/login" class="btn btn-primary" style="width: 100%;">Return to Sign In</a>
  </div>
</div>

<%- include('partials/footer') %>
