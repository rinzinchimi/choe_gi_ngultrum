<%- include('partials/header') %>

<div class="admin-layout">
  <%- include('partials/admin-sidebar') %>

  <div>
    <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap;">
      <div>
        <h2 style="font-size: 1.6rem; margin-bottom: 0.25rem;">User & Role Governance</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">
          Assign institutional roles, student leadership privileges, and audit access.
        </p>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="card">
      <div class="card-header">
        <h3 style="font-size: 1.15rem;">Registered Users (<%= users.length %>)</h3>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>College Email</th>
              <th>Department / Club</th>
              <th>Current Role</th>
              <th style="text-align: center;">Change Role</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td>#<%= u.id %></td>
                <td><strong><%= u.name %></strong></td>
                <td><%= u.email %></td>
                <td>
                  <%= u.department || 'General' %>
                  <% if (u.club_name) { %>
                    <div style="font-size: 0.75rem; color: var(--accent);"><%= u.club_name %></div>
                  <% } %>
                </td>
                <td>
                  <span class="user-badge" style="font-size: 0.75rem;"><%= u.role.replace('_', ' ') %></span>
                </td>
                <td style="text-align: center;">
                  <form action="/admin/users/<%= u.id %>/role" method="POST" style="display: inline-flex; gap: 0.5rem; align-items: center;">
                    <% if (typeof csrfToken !== 'undefined') { %>
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <% } %>
                    <select name="role" class="form-control" style="font-size: 0.8rem; padding: 0.25rem 0.5rem; width: 140px;">
                      <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>Student</option>
                      <option value="student_leader" <%= u.role === 'student_leader' ? 'selected' : '' %>>Student Leader</option>
                      <option value="finance_officer" <%= u.role === 'finance_officer' ? 'selected' : '' %>>Finance Officer</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Administrator</option>
                      <option value="auditor" <%= u.role === 'auditor' ? 'selected' : '' %>>Auditor</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary">Update</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
