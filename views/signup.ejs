<%- include('partials/header') %>

<div style="max-width: 520px; margin: 2rem auto;">
  <div class="card" style="padding: 2rem;">
    <div style="text-align: center; margin-bottom: 1.75rem;">
      <h2 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Create an Account</h2>
      <p style="color: var(--text-muted); font-size: 0.875rem;">Register as a student or apply for a verified institutional role.</p>
    </div>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul style="padding-left: 1.25rem; margin: 0;">
          <% errors.forEach(err => { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/signup" method="POST">
      <% if (typeof csrfToken !== 'undefined') { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% } %>

      <div class="form-group">
        <label for="name" class="form-label">Full Name</label>
        <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Sonam Pelmo" value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>" required autofocus>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">College Email Address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="student.sherubtse@rub.edu.bt" value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" autocomplete="email" required>
        <div class="form-hint">Recommended: student.sherubtse@rub.edu.bt. Use an email address you can access to receive verification.</div>
      </div>

      <div class="form-group">
        <label for="requestedRole" class="form-label">Account Type</label>
        <select id="requestedRole" name="requestedRole" class="form-control" required>
          <option value="student" <%= !formData.requestedRole || formData.requestedRole === 'student' ? 'selected' : '' %>>Student</option>
          <option value="student_leader" <%= formData.requestedRole === 'student_leader' ? 'selected' : '' %>>Student Leader Applicant</option>
          <option value="auditor" <%= formData.requestedRole === 'auditor' ? 'selected' : '' %>>Auditor Applicant</option>
        </select>
        <div class="form-hint">New accounts can sign in without email verification. Leader and Auditor access still requires administrator approval.</div>
      </div>

      <div class="form-group" id="institution-id-field" style="display:none;">
        <label for="institutionId" class="form-label" id="institution-id-label">Student ID</label>
        <input type="text" id="institutionId" name="institutionId" class="form-control" maxlength="100" value="<%= formData.institutionId || '' %>">
      </div>

      <div class="form-group" id="designation-field" style="display:none;">
        <label for="designation" class="form-label">Leadership Position</label>
        <input type="text" id="designation" name="designation" class="form-control" maxlength="100" placeholder="e.g. Club President or Treasurer" value="<%= formData.designation || '' %>">
      </div>

      <div class="form-group">
        <label for="department" class="form-label">Academic Department (Optional)</label>
        <input type="text" id="department" name="department" class="form-control" placeholder="e.g. Computer Science, Arts, Sciences" value="<%= typeof formData !== 'undefined' && formData.department ? formData.department : '' %>">
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Create Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Minimum 8 characters with letters and numbers" required>
        <div class="form-hint">At least 8 characters, containing uppercase, lowercase, and numeric digits.</div>
      </div>

      <div class="form-group">
        <label for="confirmPassword" class="form-label">Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Re-enter password" required>
      </div>

      <div style="background: var(--surface-alt); padding: 0.85rem; border-radius: 0.5rem; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.25rem;">
        Self-registration never grants administrator access. Student Leader and Auditor applicants must receive administrator approval.
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">
        Create Account
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
      Already have an account? <a href="/login" style="font-weight: 600;">Sign In</a>
      <div style="margin-top: 0.5rem;"><a href="/resend-verification" style="font-weight: 600;">Resend verification email</a></div>
    </div>
  </div>
</div>

<script>
  const requestedRole = document.getElementById('requestedRole');
  const institutionIdField = document.getElementById('institution-id-field');
  const institutionId = document.getElementById('institutionId');
  const institutionIdLabel = document.getElementById('institution-id-label');
  const designationField = document.getElementById('designation-field');
  const designation = document.getElementById('designation');

  function updateApplicationFields() {
    const role = requestedRole.value;
    const needsId = role === 'student_leader' || role === 'auditor';
    institutionIdField.style.display = needsId ? 'block' : 'none';
    institutionId.required = needsId;
    institutionIdLabel.textContent = role === 'auditor' ? 'Staff ID' : 'Student ID';
    designationField.style.display = role === 'student_leader' ? 'block' : 'none';
    designation.required = role === 'student_leader';
  }

  requestedRole.addEventListener('change', updateApplicationFields);
  updateApplicationFields();
</script>

<%- include('partials/footer') %>

