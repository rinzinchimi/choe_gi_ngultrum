<%- include('partials/header') %>

<div style="max-width: 500px; margin: 3rem auto; text-align: center;">
  <div class="card" style="padding: 2.5rem 2rem;">
    <div style="width: 4rem; height: 4rem; border-radius: 50%; background: #dcfce7; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.25rem;">
      ✓
    </div>

    <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Email Verified Successfully!</h2>
    <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.75rem;">
      Your college email address has been confirmed.
      <% if (applicationPending) { %>
        Your role application is now awaiting administrator review. Dashboard access begins only after approval.
      <% } else { %>
        Your account is ready. Sign in to access the portal.
      <% } %>
    </p>

    <a href="/login" class="btn btn-primary" style="width: 100%;">Sign In Now</a>
  </div>
</div>

<%- include('partials/footer') %>

