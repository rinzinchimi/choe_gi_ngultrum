# Application
PORT=3000
NODE_ENV=development
# Use a URL reachable from the device that will open the verification email.
# localhost works only on the computer running this app.
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Configured administrator account (used only by `npm run setup:admin`)
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=replace-with-a-unique-strong-admin-password

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=choe_gi_ngultrum_db
DB_USER=postgres
DB_PASS=

# Optional MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=choe_gi_ngultrum_db

# Gmail verification and password-reset email
# Enable 2-Step Verification, then create an App Password in the Google Account.
# Put the complete 16-character App Password here; spaces are accepted and removed.
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Expenditure review threshold (Nu.)
FLAG_AMOUNT_THRESHOLD=50000
